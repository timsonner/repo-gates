{
  "checks": [
    {"id": 2, "name": "identity", "severity": "FAIL"},
    {"id": 3, "name": "em_dash", "severity": "FAIL", "md_added_severity": "WARN"},
    {"id": 4, "name": "pr_body", "severity": "FAIL"},
    {"id": 5, "name": "head_pin", "severity": "FAIL"},
    {"id": 6, "name": "risk_tier", "severity": "FAIL"},
    {"id": 7, "name": "comments", "severity": "WARN"},
    {"id": 9, "name": "secrets", "severity": "WARN"}
  ],
  "defaults": {
    "scope_mode": "warn",
    "comments_mode": "warn"
  },
  "identity": {
    "name": "Tim Sonner",
    "email": "66705347+timsonner@users.noreply.github.com"
  },
  "token_shapes": [
    {
      "regex_parts": ["gh", "p_"],
      "sample_parts": ["gh", "p_", "AAAA"]
    },
    {
      "regex_parts": ["gh", "o_"],
      "sample_parts": ["gh", "o_", "AAAA"]
    },
    {
      "regex_parts": ["github", "_pat_"],
      "sample_parts": ["github", "_pat_", "AAAA"]
    },
    {
      "regex_parts": ["AK", "IA"],
      "sample_parts": ["AK", "IA", "AAAA"]
    },
    {
      "regex_parts": ["xox", "[abp]-"],
      "sample_parts": ["xox", "b-"]
    },
    {
      "regex_parts": ["-----BEGIN ", "[A-Z ]*", "PRIVATE", " KEY-----"],
      "sample_parts": ["-----BEGIN ", "RSA ", "PRIVATE", " KEY-----"]
    }
  ],
  "comment_extensions": [".rs", ".sh", ".py", ".js", ".ts", ".go", ".swift", ".nix"],
  "comment_allow": [
    "// SAFETY:",
    "///",
    "//!",
    "#!",
    "SPDX-",
    "Copyright",
    "Licensed"
  ],
  "self_check_labels": [
    "Fail-on-old proof",
    "Raw timing tries kept (if timing work)",
    "Evidence pinned to this head",
    "PR body complete",
    "Contribution guidelines read:",
    "Author and committer allowed by repo-gates config"
  ],
  "limits": {
    "min_head_sha_hex_length": 40,
    "min_self_check_boxes": 6,
    "max_risk_rank_without_rollback": 1
  },
  "risk_ranks": {
    "low": 1,
    "medium": 2,
    "high": 3
  },
  "placeholders": ["TBD", "n/a", "low | medium | high"]
}
